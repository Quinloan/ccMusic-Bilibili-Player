{
  "name": "ccmusic",
  "version": "1.5.0",
  "description": "ccMusic — B 站纯音频连播桌面端：只取音频轨流式播放，自定义收藏夹自动连播",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "undici": "^8.11.2"
  },
  "build": {
    "appId": "com.ccmusic.app",
    "productName": "ccMusic",
    "directories": {
      "output": "release-v1.5.0"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Quinloan",
      "repo": "ccMusic-Bilibili-Player"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**",
      "package.json",
      "assets/icon.png"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "shortcutName": "ccMusic"
    }
  }
}
