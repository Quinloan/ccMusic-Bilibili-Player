{
  "name": "ccmusic",
  "version": "1.6.0-beta.1",
  "description": "ccMusic — B 站纯音频连播桌面端：只取音频轨流式播放，自定义收藏夹自动连播",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "opencc-js": "1.4.2",
    "qrcode": "^1.5.4",
    "shazamio-api": "1.0.0",
    "undici": "^8.11.2"
  },
  "build": {
    "appId": "com.ccmusic.app",
    "productName": "ccMusic",
    "directories": {
      "output": "release-v1.6.0-beta.1"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Quinloan",
      "repo": "ccMusic-Bilibili-Player",
      "channel": "beta"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**",
      "package.json",
      "assets/icon.png",
      "audio-analysis.cjs",
      "shazam-provider.cjs",
      "lyric-recognition.cjs",
      "analysis-cache.cjs",
      "netease-lyrics.cjs",
      "video-search.cjs",
      "cancellation.cjs",
      "audio-downloads.cjs",
      "download-ipc.cjs",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "shortcutName": "ccMusic"
    },
    "extraResources": [
      {
        "from": "resources/download-audio",
        "to": "download-audio",
        "filter": [
          "ffmpeg.exe",
          "LICENSE*",
          "download-manifest.json",
          "README.md"
        ]
      },
      {
        "from": "resources/ffmpeg-mini.exe",
        "to": "ffmpeg-mini.exe"
      },
      {
        "from": "resources/afp",
        "to": "afp"
      },
      {
        "from": "resources/whisper",
        "to": "whisper",
        "filter": [
          "ggml-small-q5_1.bin",
          "download-manifest.json",
          "LICENSE*",
          "THIRD-PARTY*",
          "Release/ggml*.dll",
          "Release/whisper.dll",
          "Release/whisper-cli.exe"
        ]
      }
    ],
    "generateUpdatesFilesForAllChannels": false
  }
}
